(((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . #2="2.0") (method . "initialize") (id . 1)
	   (params
	    (clientInfo (name . "agent-shell")
			(title . "Emacs Agent Shell")
			(version . "0.74.2"))
	    (protocolVersion . 1)
	    (clientCapabilities
	     (fs (readTextFile . t) (writeTextFile . t))
	     (elicitation (form))))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 1)
	   (result (protocolVersion . 1)
		   (agentCapabilities
		    (_meta (claudeCode (promptQueueing . t)))
		    (promptCapabilities (image . t)
					(embeddedContext . t))
		    (mcpCapabilities (http . t) (sse . t))
		    (auth (logout)) (providers) (loadSession . t)
		    (sessionCapabilities (additionalDirectories)
					 (close) (delete) (fork)
					 (list) (resume)))
		   (agentInfo
		    (name . "@agentclientprotocol/claude-agent-acp")
		    (title . "Claude Agent") (version . "0.70.0"))
		   (authMethods . #1=[])
		   (_meta
		    (jetbrains
		     (air (version . 1)
			  (capabilities
			   . ["sessionFailure" "agentFileChangeReport"])))
		    (steering (supported . t))
		    (goal (version . 1)
			  (controlMethod . "_session/goal")
			  (actions . ["set" "clear"]))))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
	   (params
	    (sessionId . "866901fc-f565-4ff7-b3c8-b6c3905fb293")
	    (update
	     (_meta (claudeCode (toolName . "AskUserQuestion")))
	     (toolCallId . "toolu_018EPi8fBMWmYGL3cfag3v9c")
	     (sessionUpdate . "tool_call") (rawInput)
	     (status . "pending") (title . "Asking for your input")
	     (kind . "other") (content . #1#)))))
